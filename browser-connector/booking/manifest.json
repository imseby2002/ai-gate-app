{
  "manifest_version": 3,
  "name": "AI-GATE 讀後台連接器",
  "version": "0.2.0",
  "description": "讀取已登入的 OTA 後台訂單頁（Booking.com / Agoda / Trip.com / AsiaYo / Expedia），把新訂單/取消推送到 AI-GATE（唯讀，不自動操作平台）。",
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "host_permissions": [
    "https://admin.booking.com/*",
    "https://ycs.agoda.com/*",
    "https://ebooking.trip.com/*",
    "https://*.ctrip.com/*",
    "https://expert.asiayo.com/*",
    "https://*.asiayo.com/*",
    "https://apps.expediapartnercentral.com/*",
    "https://*.expediapartnercentral.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "AI-GATE 讀後台連接器" },
  "content_scripts": [
    {
      "matches": [
        "https://admin.booking.com/*",
        "https://ycs.agoda.com/*",
        "https://ebooking.trip.com/*",
        "https://*.ctrip.com/*",
        "https://expert.asiayo.com/*",
        "https://*.asiayo.com/*",
        "https://apps.expediapartnercentral.com/*",
        "https://*.expediapartnercentral.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
