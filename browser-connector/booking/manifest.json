{
  "manifest_version": 3,
  "name": "AI-GATE Booking 讀後台連接器",
  "version": "0.1.0",
  "description": "讀取已登入的 Booking.com extranet 訂單頁，將新訂單/取消推送到 AI-GATE（唯讀，不自動操作平台）。",
  "permissions": ["storage", "alarms", "notifications", "scripting"],
  "host_permissions": [
    "https://admin.booking.com/*",
    "https://*.booking.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "AI-GATE Booking 連接器" },
  "content_scripts": [
    {
      "matches": ["https://admin.booking.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
