# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# cli-proxy — 真實設定含金鑰，不入 git
docker/cli-proxy/config.yaml
docker/cli-proxy/auths/
docker/cli-proxy/logs/

# vercel
.vercel

# cloudflare build output
.open-next/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# local scratch files
/scratch/
